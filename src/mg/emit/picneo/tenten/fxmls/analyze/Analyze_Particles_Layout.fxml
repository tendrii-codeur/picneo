<BorderPane minHeight="806.0" minWidth="1400.0" prefHeight="818.0" prefWidth="1400.0" style="-fx-background-color: white; -fx-border-color: #9a9a9a; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/9.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mg.emit.picneo.tenten.controllers.analyze.Analyze_Particles_Controller">
